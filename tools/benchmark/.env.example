# benchmark's own .env -- copy to benchmark/.env and fill in (it is gitignored).
# This is the DEFAULT env file for benchmark: it is auto-loaded, no flag needed.
#
# WHAT LIVES WHERE (repo-wide taxonomy, see root CONFIG.md):
#   * This .env  = the JUDGE model's CONNECTION identity + secret (api_key),
#                  and optional DEFAULT run inputs (BENCHMARK_FOLDER/SCOPE/OUT).
#                  The judge must be MULTIMODAL -- the PDF is graded from
#                  rendered page images.
#   * config/default.toml = grading TUNING (dpi, weights, max_pages, chunk,
#                  token budgets). Committed, reviewed. NOT here.
#   * CLI flags  = per-run overrides that beat this file (-f/-s/-o for inputs,
#                  --model/--provider/--num-ctx/--thinking for the model).
#
# ---------------------------------------------------------------------------
# HOW benchmark LOADS .env FILES  (cli.py:_load_env)
# ---------------------------------------------------------------------------
# Files are loaded LAYERED, highest precedence first; each fills only what the
# higher ones leave unset (real environment variables win over all of them):
#     1. --env-file <path>   (explicit)
#     2. benchmark/.env      <- THIS file, the default home for a judge-specific
#                               model / inputs
#     3. ./.env              (repo root)
#     4. parser/.env         (shared parser model config)
#
# Because it's layered, this file does NOT have to be complete: set only
# VLM_MODEL here to swap just the judge model, and provider/base_url still come
# from parser/.env below it. Set the whole block to be fully self-contained.
#
# ---------------------------------------------------------------------------
# JUDGE MODEL (VLM_* ; each falls back to its LLM_* counterpart)
# ---------------------------------------------------------------------------
# Any provider parser/llm supports works: ollama, anthropic, openai-compatible,
# openrouter. Local Ollama example (must be a multimodal model):
# Varsayilan (gercek .env'de kullanilan): ollama
VLM_PROVIDER=
# Varsayilan (gercek .env'de kullanilan): http://localhost:11434/v1
VLM_BASE_URL=
# Varsayilan (gercek .env'de kullanilan): nemotron3:33b
VLM_MODEL=
VLM_API_KEY=

# Thinking/reasoning toggle. A hybrid-reasoning judge left ON can burn the whole
# response budget on hidden <think> tokens and return empty/unparseable content
# -- the [2/2] preflight check catches this live, but keep it off unless you
# know the model needs it. "1"/"true"/"yes"/"on" = on; anything else / unset = off.
# Varsayilan (gercek .env'de kullanilan): 0
VLM_THINKING_ON=

# Ollama only: force the context window (tokens) via Ollama's native /api/chat
# instead of /v1 -- the only way to keep the judge's own prompt (page images +
# full Markdown) from being silently truncated. Left unset on ollama, a safe
# default (16384) is applied automatically. Raise it if documents run long and
# you see "degenerate output"/truncation (limited by the server's VRAM: a bigger
# window means a bigger KV cache).
# VLM_NUM_CTX=32768

# Anthropic judge instead (api_key is a SECRET -- lives here, never in the TOML):
# VLM_PROVIDER=anthropic
# VLM_MODEL=claude-opus-4-8
# VLM_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# DEFAULT RUN INPUTS (optional; a -f/-s/-o CLI flag always overrides these)
# ---------------------------------------------------------------------------
# The folder to grade (one .pdf+.md, or a batch of such subfolders). Set this to
# skip typing -f every run. A CLI -f/--folder still wins.
# BENCHMARK_FOLDER=pipeline/e2e_test_output/2026-07-20_12-57-06
# A scope .md restricting what is graded (omit = whole document). CLI -s wins.
# BENCHMARK_SCOPE=benchmark/scope.md
# Where to write the JSON report (omit = benchmark/benchmark_reports/<ts>__<name>.json).
# A path to an existing directory (or one ending in / or \) is treated as a
# reports dir -- the usual <ts>__<name>.json is generated inside it, not used
# as a literal filename. CLI -o wins.
# BENCHMARK_OUT=benchmark/benchmark_reports/latest.json
# BENCHMARK_OUT=D:/medrag_reports/
