{"query": "pxie jetson agx xavier modulunun kodu neydi", "expected_intent": "product_fact", "lang": "tr"}
{"query": "de1000 chassis kac slotlu", "expected_intent": "product_fact", "lang": "tr"}
{"query": "de150000 nedir ne ise yariyo", "expected_intent": "product_fact", "lang": "tr"}

