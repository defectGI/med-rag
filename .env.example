# =============================================================================
# med-rag root .env template — copy with `cp .env.example .env`, fill in.
#
# This file feeds the compose side:
#   1) ${...} variable substitution (values inside compose.yaml)
#   2) `env_file: .env` — all lines are passed verbatim to the environment of
#      the web + pipeline-worker + pipeline containers (same value in three services).
#
# FULL variable catalog and role-based explanations: CONFIG.md + component
# templates (src/medrag/api/.env.example, src/medrag/pipeline/*/...).
# Secret-bearing lines ONLY here (.env is gitignored).
# =============================================================================

# --- Deploy layout (compose substitution only; does not enter the container) ------------
# Corpus: BELGELER/, notlar/, parsed/, chunks/, backups... THE single persistent root.
CORPUS_HOST_DIR=/home/user/med-rag/korpus
# Logs (chatbot + conversation log). A plain folder, not a named volume — so they can
# be opened from the file manager on the host.
LOGS_HOST_DIR=/home/user/med-rag/loglar

# --- Single-user password (K3/E5) ------------------------------------------
# If left EMPTY, authentication is COMPLETELY OFF and the API is reachable
# without a password — do not expose outside the home network. Provide a strong value.
MEDRAG_SIFRE=
# Session cookie signing key. If empty, derived from the password (sufficient for
# single-user). If you want sessions to become invalid when the password changes,
# provide it separately.
MEDRAG_GIZLI_ANAHTAR=

# --- Upload limit (Open-5) --------------------------------------------------
# MB per file. Default 200.
MEDRAG_MAX_YUKLEME_MB=200

# --- Answer model (chatbot) --------------------------------------------------
CHATBOT_LLM_PROVIDER=        # ollama | openai | openrouter | local | anthropic
CHATBOT_LLM_BASE_URL=        # e.g. http://host.docker.internal:11434/v1
CHATBOT_LLM_API_KEY=         # REQUIRED for anthropic; optional otherwise
CHATBOT_LLM_MODEL=

# --- Embedding (shared by vectorize + retrieval) ---------------------------------
# CRITICAL ALIGNMENT: EMBEDDING_MODEL + the Qdrant collection name (in vectorize
# config/default.toml) + the chatbot side must be the same; if the model changes,
# rebuild the collection (see DEPLOY.md).
EMBEDDING_PROVIDER=          # ollama | openai | openrouter | local
EMBEDDING_MODEL=             # e.g. qwen3-embedding:8b (1024/4096 dimensions)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=          # REQUIRED for "local"
# Vector collection name (must match the `[qdrant].collection_name` in vectorize
# config/default.toml). Default: medrag_chunks_qwen3_8b
QDRANT_COLLECTION=

# --- Parse (VLM) -------------------------------------------------------------
# VLM for scanning PDFs during nightly/upload processing. It can be the same
# endpoint as a regular LLM. (compose note: if you want a parse-specific override,
# it's written into the task command — the values here affect all services.)
LLM_PROVIDER=                # ollama | openai | openrouter | local
LLM_BASE_URL=                # NO /v1 SUFFIX on the PARSE side (see CONFIG.md)
LLM_API_KEY=
LLM_MODEL=
