# =============================================================================
# med-rag kök .env şablonu — `cp .env.example .env` ile kopyala, doldur.
#
# Bu dosya compose tarafını besler:
#   1) ${...} değişken ikamesi (compose.yaml içindeki değerler)
#   2) `env_file: .env` — tüm satırlar web + pipeline-worker + pipeline
#      konteynerlerinin ortamına aynen aktarılır (aynı değer üç servisde).
#
# TAM değişken kataloğu ve rol-bazlı açıklamalar: CONFIG.md + bileşen
# şablonları (src/medrag/api/.env.example, src/medrag/pipeline/*/...).
# Sır taşıyan satırlar YALNIZCA burada (.env gitignore'dadır).
# =============================================================================

# --- Deploy yerleşimi (yalnız compose ikamesi; konteynıra girmez) ------------
# Korpus: BELGELER/, notlar/, parsed/, chunks/, yedekler... TEK kalıcı kök.
CORPUS_HOST_DIR=/home/user/med-rag/korpus
# Loglar (chatbot + conversation log). Host'ta dosya yöneticisinden açılabilir
# olsun diye adlandırılmış volume değil, düz klasör.
LOGS_HOST_DIR=/home/user/med-rag/loglar

# --- Tek kullanıcı şifresi (K3/E5) ------------------------------------------
# BOŞ bırakılırsa kimlik doğrulama TAMAMEN KAPALI olur ve API şifresiz
# erişilebilir — ev ağı dışına açmayın. Güçlü bir değer verin.
MEDRAG_SIFRE=
# Oturum çerezi imza anahtarı. Boşsa şifreden türetilir (tek kullanıcı için
# yeterli). Şifre değişince oturumların geçersiz olmasını isterseniz ayrıca
# verin.
MEDRAG_GIZLI_ANAHTAR=

# --- Upload limiti (Açık-5) --------------------------------------------------
# Dosya başına MB. Varsayılan 200.
MEDRAG_MAX_YUKLEME_MB=200

# --- Cevap modeli (chatbot) --------------------------------------------------
CHATBOT_LLM_PROVIDER=        # ollama | openai | openrouter | local | anthropic
CHATBOT_LLM_BASE_URL=        # ör. http://host.docker.internal:11434/v1
CHATBOT_LLM_API_KEY=         # anthropic için ZORUNLU; diğerlerinde opsiyonel
CHATBOT_LLM_MODEL=

# --- Embedding (vectorize + retrieval ortak) ---------------------------------
# KRİTİK HİZALAMA: EMBEDDING_MODEL + Qdrant koleksiyon adı (vectorize
# config/default.toml) + chatbot tarafı aynı olmalı; model değişirse koleksiyonu
# yeniden kurun (bkz. DEPLOY.md).
EMBEDDING_PROVIDER=          # ollama | openai | openrouter | local
EMBEDDING_MODEL=             # ör. qwen3-embedding:8b (1024/4096 boyut)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=          # "local" için ZORUNLU
# Vektör koleksiyon adı (vectorize config/default.toml daki `[qdrant].collection_name`
# ile aynı olmalı). Varsayılan: medrag_chunks_qwen3_8b
QDRANT_COLLECTION=

# --- Parse (VLM) -------------------------------------------------------------
# Gecelik/upload işleminde tarama PDF'leri için VLM. Sıradan LLM ile aynı
# endpoint olabilir. (compose notu: parse'a özgü override isterseniz görev
# komutuna yazılır — buradaki değerler tüm servisleri etkiler.)
LLM_PROVIDER=                # ollama | openai | openrouter | local
LLM_BASE_URL=                # PARSE tarafında /v1 SUFIKSİ YOK (bkz. CONFIG.md)
LLM_API_KEY=
LLM_MODEL=
