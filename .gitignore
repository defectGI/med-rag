*.pdf
*.png
*.jpg
*.JPG
*.jpeg
*.gif
*.stp
*.xlsx
*.docx
*.db
# specs.db falls under the general `*.db` rule above; the explicit ignore
# lines in the facts/ block cover it together with its `specs.db.legacy_*`
# copies (which never matched `*.db` in the first place -- their names do not
# end in ".db").
*.log
*.log.[0-9]*
# chatbot persistent log directory (RotatingFileHandler;
# src/medrag/api/logging_setup.py) -- kept as DATA in the old root-level
# chatbot/ directory, not moved when the code moved.
chatbot/logs/

# ---------------------------------------------------------------
# Large data folders
# ---------------------------------------------------------------
chatbot-corpus/BELGELER/
chatbot-corpus/extra_corpus/

# ---------------------------------------------------------------
# Generated outputs / work directories
# ---------------------------------------------------------------
pipeline/chunk_test_output/
pipeline/e2e_test_output/
pipeline/extra_corpus_output/
pipeline/full_parse_output/
pipeline/scratch/
pipeline/storage/
parser/storage/*
!parser/storage/README.md

# Root storage/ + qdrant: Qdrant's own runtime data directory/binary. An
# accidental commit once put ~1.3GB of this in git history; purging it fully
# requires history rewriting (filter-repo + force-push).
/storage/
/qdrant
# Qdrant's DEFAULT storage layout (collections/ + aliases/ + raft_state.json)
# -- created when Qdrant is run with the repo root as its working directory.
# It entered the repo once via an accidental `git add` (~624MB) and was
# removed; ignored so it cannot return: binary data does not belong in the
# repo.
/collections/
/aliases/
/raft_state.json
benchmark/benchmark_reports/
# Timestamped output of a full-corpus run (run_full.py; each run writes
# parsed/ images/ chunks/ + snapshot + manifest under runs/<ts>/)
runs/
# Scratch pipeline run of tools/baseline/capture_baseline.sh (temporary)
tools/baseline/scratch/

# ---------------------------------------------------------------
# Tooling / editor
# ---------------------------------------------------------------
.claude/
AGENTS.md
review/

# service/: session input/instruction files (prompt text given to a worker
# agent), NOT a persistent document -- kept separate from real planning
# documents.
service/sanaprompt.txt

# Session-internal TEMPORARY backups -- not persistent artifacts, just copies
# taken in the moment to be able to roll back a run. The explicitly ignored
# `specs.db.legacy_*` lines above are a SEPARATE category; the patterns below
# lose all value when the session ends and must not bloat the repo.
facts/experiments/*/results/*.bak_*
facts/experiments/*/results_bak_*/
# Per-chunk checkpoint of the catalog_chunk_ownership run (build_all.py --
# used to resume if a run is cut short; the table itself lives in
# `chunk_ownership_all.json`)
facts/experiments/catalog_chunk_ownership/results/chunk_owner_progress.jsonl

# DEVLOG/ROADMAP are not tracked in git -- they remain local per-component
# work-log files.
DEVLOG.md
ROADMAP.md
# Old/archived reports -- historical record, not active work anymore.
/arsiv/

# Session-internal workflow orchestration scripts -- temporary tooling,
# NOT persistent artifacts.
service/.workflow-*.js

# Ownership output directory: runtime data whose default path is INSIDE the
# code tree (core/paths.py::CHUNK_OWNERSHIP_DIR). In production it is
# relocated under /corpus via CHUNK_OWNERSHIP_DIR; a local run drops it here
# and it MUST NOT be committed.
src/medrag/pipeline/facts/catalog_chunk_ownership/results/

# med-rag runtime verisi (DEPLOY.md): korpus (yükleme/parse/vectorize/durum)
# + loglar (bilinçli olarak repo DIŞINDA tutulur; tıbbi veri + sohbet izi).
korpus/
loglar/
