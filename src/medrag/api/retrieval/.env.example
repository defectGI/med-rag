# ---------------------------------------------------------------------------
# [db_query]  (text-to-SQL over a ready-made DB, via text2sql-engine)
# ---------------------------------------------------------------------------
# SQL generation is configured by text2sql-engine's OWN .env + config.toml
# (schema path, per-stage provider/model/base_url, dialect). This module only
# points at those files and at the DB the generated SQL runs against.
#
# DB_QUERY_DB_PATH=            # SQLite file the generated SQL is executed against
# DB_QUERY_TEXT2SQL_ENV=       # path to text2sql-engine's .env  (optional)
# DB_QUERY_TEXT2SQL_CONFIG=    # path to text2sql-engine's config.toml (optional)
# DB_QUERY_DIALECT=sqlite      # target dialect; sqlite adds an ILIKE->LIKE rewrite
