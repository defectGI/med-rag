# Copy: cp .env.example .env — .env is gitignored (the root .gitignore's
# `.env`/`.env.*` rule covers this component too).
#
# retrieval's own modules (intent_classification, db_query) read THEIR OWN env
# variables from retrieval/.env -- this file only covers THIS component's
# role: the model that actually answers the user. Keeping it separate is the
# same principle as the benchmark keeping its own judge model separate from the parser
# (root CONFIG.md footnote 2): a distinct role deserves its own env namespace.

# ---------------------------------------------------------------------------
# [answering_model] — the model producing the final answer returned to the user
# ---------------------------------------------------------------------------
# Only a remote endpoint (root AGENTS.md GPU rule: no local
# inference on this machine) -- ollama/openai/openrouter/local use OpenAI-compatible
# `/v1/chat/completions`, while anthropic uses the native Messages API (2026-08-27, see
# core/llm/anthropic.py).
CHATBOT_LLM_PROVIDER=       # ollama | openai | openrouter | local | anthropic
CHATBOT_LLM_BASE_URL=       # e.g. http://<inference-host>:8000/v1 (optional for ollama/openai/openrouter/anthropic; the natural root is known)
CHATBOT_LLM_API_KEY=        # REQUIRED for anthropic (e.g. sk-ant-...)
CHATBOT_LLM_MODEL=          # servis edilen model id
# Default (used in the real .env): 60
CHATBOT_LLM_TIMEOUT=
# Ollama's OpenAI-compatible `/v1` endpoint CANNOT pass num_ctx per-request
# (ollama#5356) -- an over-budget prompt is SILENTLY TRUNCATED. If provider=ollama AND this
# is empty, it falls back to the 16384 default (the request automatically goes to native /api/chat,
# and it's written back to CHATBOT_LLM_NUM_CTX for observability). If on the real machine
# this role shares the SAME weights as text2sql's LINKING_MODEL (e.g.
# gemma4:26b), to avoid reload/cold-start it is RECOMMENDED to align with the context
# that model uses in linking (e.g. 262144, see text2sql/config.toml
# [linking] num_ctx) -- if the provider is NOT ollama this field has no effect.
# CHATBOT_LLM_NUM_CTX=
# Thinking/reasoning suppression -- OPT-IN. Only if you EXPLICITLY write `off` is the
# suppression body injected; if this line is absent/`on` then NOTHING is added (neutral).
# If a hybrid-reasoning model is left with thinking on, on a short-answer task it
# may spend its budget on hidden <think> and return empty content -- then set `off`.
# The answering model meets a rejected body with a body-less retry; still, at
# startup it preflight-probes and prints to the terminal (see the correct body there).
# CHATBOT_LLM_THINKING=off
# Suppression body (JSON), only when THINKING=off. Default
# {"reasoning_effort": "none"}. Depending on your server, e.g.:
# Ollama native  -> {"think": false}   (if Ollama /v1 accepts this)
# vLLM Qwen3      -> {"chat_template_kwargs": {"enable_thinking": false}}
# CHATBOT_LLM_THINKING_OFF_BODY=

# Preflight: on failure (endpoint down / thinking leak) the default is
# WARN + CONTINUE. If you want fail-fast (cancel startup):
# CHATBOT_PREFLIGHT_STRICT=1

# ---------------------------------------------------------------------------
# [reconciler] — L0+L1: session state + elliptical query resolution (small model)
# ---------------------------------------------------------------------------
# Tracks the user's ongoing intent and converts context-embedded turns like "what about
# the other one" into independent queries (see reconciler.py). DEFAULT: shares intent's
# small model (LLM_* in retrieval/.env -- a single loaded model, VRAM friendly). If you
# want a separate model fill in the following (falls back to LLM_* if empty):
# RECONCILER_BASE_URL=
# RECONCILER_MODEL=
# RECONCILER_API_KEY=
# Thinking (see explanation above): on | off (default off).
# RECONCILER_THINKING=off
# RECONCILER_THINKING_OFF_BODY=
# provider/num_ctx also follows the SAME RECONCILER_* -> LLM_* fallback pattern
# (counts as "openai" if empty -- reconciler/continuation has not carried the provider
# concept until now, it was added with this num_ctx need). If LLM_PROVIDER=ollama and
# this is empty, it falls to the SAME 16384 default as CHATBOT_LLM_NUM_CTX
# (see the CHATBOT_LLM_NUM_CTX note above -- reload/cold-start fix).
# RECONCILER_PROVIDER=
# RECONCILER_NUM_CTX=
# NOTE: if LLM_* is not configured at all, reconciler is not set up -> Orchestrator
# skips L0/L1 (the raw query is classified directly, old behavior).

# ---------------------------------------------------------------------------
# [continuation] — is a pinned clarification/handoff still valid? (small model)
# ---------------------------------------------------------------------------
# Decision: 2026-07-27 -- `RecommendationFlow`/`ComparisonFlow`/`DocDownloadFlow`'s
# check_pin AND the handoff confirmation (`Orchestrator._is_affirmative`) are no
# longer delegated to a hardcoded cancel/confirm word list but to this small LLM call
# (see the continuation.py module docstring -- root cause: a fixed list was structurally
# insufficient for the "which message continues/cancels/confirms" question). DEFAULT:
# shares reconciler/intent's SMALL model (LLM_* in retrieval/.env). If you want a
# separate model fill in the following (falls back to LLM_* if empty):
# CONTINUATION_BASE_URL=
# CONTINUATION_MODEL=
# CONTINUATION_API_KEY=
# Thinking (see explanation above): on | off (default off).
# CONTINUATION_THINKING=off
# CONTINUATION_THINKING_OFF_BODY=
# provider/num_ctx -- the SAME CONTINUATION_* -> LLM_* fallback pattern as
# RECONCILER_PROVIDER/NUM_CTX (see the reconciler note above, reload/cold-start fix).
# CONTINUATION_PROVIDER=
# CONTINUATION_NUM_CTX=
# NOTE: if LLM_* is not configured at all, the checker is not set up -> all three flows
# + the handoff confirmation fall back to their old (hardcoded word list) FALLBACK.

# ---------------------------------------------------------------------------
# [slot_selector] — recommendation's dynamic clarification-question selection (small model)
# ---------------------------------------------------------------------------
# Decision: 2026-08-04 -- `RecommendationFlow`'s question pool is no longer 3 hardcoded
# keys but is built from the dictionary in `facts/db/schema.yaml` (no drift risk) + the keys
# that truly discriminate in this family (deterministic SQL, the LLM does not write
# it) -- this small LLM call ONLY makes the "which of the candidates is most useful in
# this conversation context" decision (see the slot_selection.py module docstring,
# the SAME Protocol+graceful-degrade pattern as continuation.py). DEFAULT: shares
# reconciler/continuation's SMALL model (LLM_*). If you want a separate model fill in the
# following (falls back to LLM_* if empty):
# SLOT_SELECTOR_BASE_URL=
# SLOT_SELECTOR_MODEL=
# SLOT_SELECTOR_API_KEY=
# Thinking (see explanation above): on | off (default off).
# SLOT_SELECTOR_THINKING=off
# SLOT_SELECTOR_THINKING_OFF_BODY=
# provider/num_ctx -- the SAME SLOT_SELECTOR_* -> LLM_* fallback pattern as
# CONTINUATION_PROVIDER/NUM_CTX.
# SLOT_SELECTOR_PROVIDER=
# SLOT_SELECTOR_NUM_CTX=
# NOTE: if LLM_* is not configured at all, the selector is not set up -> `recommendation`
# falls back to its old (static 3-key emergency pool) FALLBACK.

# ---------------------------------------------------------------------------
# [intent_classification] — the classifier Orchestrator calls first each turn
# ---------------------------------------------------------------------------
# Decision: 2026-08-06, user request. This role's model/endpoint does NOT LIVE in THIS
# file -- retrieval reads its own `LLM_BASE_URL`/`LLM_MODEL`/`LLM_API_KEY`
# (from retrieval/.env, see the file-head note above); `factory.py::
# _build_intent_chat_model` uses those values UNCHANGED. The only
# field here is which PATH it's called through:
#
# retrieval is deliberately provider-agnostic (it contains no Ollama-specific code,
# see retrieval/AGENTS.md) -- if LLM_MODEL shares the SAME Ollama weights (e.g.
# gemma4:31b) as chatbot's answering/reconciler/continuation/linking roles, and those
# roles FORCE num_ctx via native `/api/chat`, this role's plain `/v1` call without
# num_ctx loads Ollama with its own default context -> the model constantly reloads
# between the two values (cold-start thrash, diagnosis: 2026-08-06, verified with live
# `ollama ps`).
#
# If INTENT_PROVIDER=ollama is EXPLICITLY set (default empty = old behavior,
# retrieval's plain `/v1` path, no num_ctx) `chatbot/chatbot/
# ollama_chat_model.py::NativeOllamaChatModel` kicks in -- it routes LLM_BASE_URL/
# LLM_MODEL to native `/api/chat`, forcing INTENT_NUM_CTX (falls back to the 16384
# default if empty, the SAME pattern as the other *_NUM_CTX fields). This is NOT a
# machine-wide Ollama server setting (OLLAMA_CONTEXT_LENGTH) -- it is role-based,
# configurable in this component's own .env.
# INTENT_PROVIDER=ollama
# Use the same value as CHATBOT_LLM_NUM_CTX/RECONCILER_NUM_CTX/CONTINUATION_NUM_CTX
# (so the shared model works without reloads):
# INTENT_NUM_CTX=16384

# ---------------------------------------------------------------------------
# [top_n target] — the Qdrant collection where the vectors are written (ENTER HERE)
# ---------------------------------------------------------------------------
# passed directly to retrieval.modules.top_n.build_default_retriever
# (src/medrag/api/factory.py::build_top_n_retriever_from_env) -- this component reads
# its OWN .env and passes it as a parameter; it does NOT read retrieval's process
# environment (isolation pattern, factory.py docstring). Which Qdrant to
# connect to is decided by this component (per deployment), not by the retrieval
# package (the same principle applies to db_query, below).
#
# With D-52 (2026-08-19) the names were ALIGNED with the unprefixed
# QDRANT_URL/QDRANT_API_KEY scheme used by `vectorize` (the writing side) AND
# retrieval/modules/top_n's OWN .env (previous name:
# CHATBOT_QDRANT_*, see service/DUZELTMELER.md D-13) -- all three components look at the
# same Qdrant, and now all three carry the same names. Since the processes are separate,
# the same name creates NO conflict; it only reduces the number of names kept in memory
# from 3 to 1.
#
# The address of the real collection written by vectorize on the GPU machine:
QDRANT_URL=
QDRANT_API_KEY=
# Must be the SAME as the [qdrant].collection_name in src/medrag/pipeline/vectorize/config/default.toml
# (the current value there is: "medrag_chunks_qwen3_8b" -- the name carries the embedding
# model that WRITES the collection; see the EMBEDDING_MODEL warning below).
QDRANT_COLLECTION=

# Queries must be embedded with the SAME model that writes the vectors
# (retrieval.modules.top_n uses the shared EMBEDDING_* -- the exact same values as the
# EMBEDDING_PROVIDER/MODEL/API_KEY/BASE_URL in vectorize/.env). If they differ,
# either the search returns meaningless results or it fails loudly with a Qdrant
# dimension mismatch.
#
# CASE STUDY (2026-08-07): `qwen3-embedding:8b` (4096) was written here but the
# collection was written with `0.6b` (1024) -- EVERY request failed with "Vector dimension error:
# expected dim: 1024, got 4096". The `_qwen3_8b` in the collection name was misleading: the name
# said 8b, the content was 0.6b. If you suspect a mismatch, ask the collection's
# REAL dimension, don't trust the name:
#   curl -s <qdrant>/collections/<name> | python -c #     "import sys,json;print(json.load(sys.stdin)['result']['config']['params']['vectors'])"
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# ---------------------------------------------------------------------------
# [db_query target] — the SQL of the sql_topn flow runs against which prepared DB
# ---------------------------------------------------------------------------
# passed directly to retrieval.modules.db_query.build_default_retriever;
# held HERE not in retrieval/.env -- which DB to connect to is decided by this
# component (per deployment), not by the retrieval package.
#
# specs.db (real product/spec data, ~2.2MB) is COMMITTED in the repo:
# facts/db/specs.db (the `!facts/db/specs.db` exception in the root .gitignore; decision
# 2026-07-24, the path was moved to the facts/ component with KARAR-026 on 2026-07-27).
# CAN BE LEFT EMPTY -- factory.py falls back to the committed file. Only if you will use a
# DIFFERENT/newer DB write the full path here:
CHATBOT_DB_QUERY_DB_PATH=

# --- text2sql-engine's OWN env fields (unprefixed -- text2sql's own fixed
# names, chatbot cannot change or prefix them) --------------
# config.toml + prompts/ are committed in this component under chatbot/text2sql/;
# schema.yaml however is in the root facts/ component (facts/db/schema.yaml, KARAR-026).
# If SCHEMA_PATH is left EMPTY here, chatbot/factory.py automatically falls back to that
# committed file -- only fill it in if you want a DIFFERENT schema.
# SCHEMA_PATH=

# Linking/SQL prompt templates -- if left empty, chatbot/factory.py automatically falls
# back to the committed chatbot/text2sql/prompts/ (same pattern as SCHEMA_PATH). Those
# templates are the same as text2sql-engine's packaged defaults, with ONE difference: a
# rule suppressing the thinking/reasoning-trace output has been added (decision 2026-07-23
# -- LINKING_MODEL/SQL_MODEL may be hybrid-reasoning models, but text2sql-engine 0.2.0's
# provider layer offers no seam for the request-body suppression pattern in
# chatbot/chatbot/thinking.py; adding an instruction to the template via PROMPT_DIR is the
# only alternative, and its guarantee is less certain than request-body
# suppression, which is the exact equivalent in the request body). Fill in if you want a
# DIFFERENT template.
# PROMPT_DIR=

# Stage 1 (schema linking) + Stage 2 (SQL generation) -- they may be separate models
# (per the EAV schema in facts/db/DATA_DICTIONARY.md a proven working combination is:
# a general model for linking, and a coder-specialized model
# for SQL).
#
# provider = "ollama" -- **CORRECTION (2026-07-30):** the old comment below this line
# said "native provider added in sqlretrieve 0.4.0"; that version could not be found
# anywhere (on GitHub, in this monorepo, on local disk) -- it was probably hand-edited
# in the installed package but never committed, and a `pip install
# -r requirements` silently overwrote it with the real (ollama-less) 0.2.0 from PyPI
# (a third time). Now the "ollama" provider is provided by **`chatbot/vendor/text2sql-engine`**
# (a vendored local fork in this repo, installed with `pip install -e`, version
# `0.2.0+ollama1`) -- upstream (`defectGI/sqlretrieve`) is still
# at 0.2.0 and does not carry this provider. `retrieval/pyproject.toml`'s `db_query`
# extra is pinned to this EXACT version string (which never matches on PyPI) so it
# isn't silently overwritten again -- details: `chatbot/vendor/text2sql-engine/
# README.md` + root `DEVLOG.md` 2026-07-30.
#
# It uses Ollama's OWN native `/api/chat` endpoint. Why NOT "openai" (i.e.
# /v1): the /v1 endpoint cannot pass num_ctx per-request (ollama#5356) and when the dev
# schema.yaml exceeds the default context window it SILENTLY TRUNCATES the prompt ->
# linking returns empty/corrupt JSON (StructuredOutputError). The native provider
# passes the [linking]/[generation] num_ctx in config.toml as options.num_ctx.
# BASE_URL may keep or drop /v1 -- the provider tolerates
# it and converts it to /api/chat. **KNOWN GAP:** this fork does NOT yet implement
# the thinking/`think:false` suppression (as in chatbot's own `thinking.py` pattern)
# -- only num_ctx is covered; the thinking-toggle is a separate task.
#
# Note: the other roles that DON'T need num_ctx (CHATBOT_LLM_*, RECONCILER_*,
# CONTINUATION_*, EMBEDDING_*) stay on "openai"/v1 -- do NOT remove /v1 from those.
# Default (used in the real .env): ollama / gemma4:31b / http://localhost:11434
LINKING_PROVIDER=
LINKING_MODEL=
LINKING_BASE_URL=

# Default (used in the real .env): ollama / qwen2.5-coder:32b / http://localhost:11434
SQL_PROVIDER=
SQL_MODEL=
SQL_BASE_URL=

# The native ollama provider needs no key; it is kept for a role that falls to
# openai/anthropic (Ollama already ignores a non-empty value).
# Default (used in the real .env): ollama (dummy value, not a real key)
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# [image serving] — image_id -> crop file (ROADMAP 10e)
# ---------------------------------------------------------------------------
# DELIBERATE ARCHITECTURAL EXCEPTION (decision: 2026-07-27, user approval in this session
# -- see root AGENTS.md "new dependency/role added" section + chatbot/
# AGENTS.md). `chatbot` normally never touches `parser`/`chunker`/`vectorize`'s
# STORAGE (it only imports `retrieval` as a pip dependency)
# -- `GET /api/images/<image_id>` (webapp.py) is the ONE exception to this rule: it
# resolves `image_id` (parser's `sha256:<hex>` format, PROTOCOL.md
# KARAR-002) to the real file in parser's crop blob store (see parser/storage_paths.py
# ::images_dir, default storage/images). NO CODE IS IMPORTED
# -- only the filesystem is shared; the naming rule is MIRRORED in
# chatbot/chatbot/image_store.py (not an import).
#
# Point to the SAME directory as Parser's STORAGE_IMAGES_DIR (404 if different).
# WARNING: parser's default "storage/images" is a RELATIVE path, i.e. it resolves
# relative to the directory parser RUNS in -- since the pipeline runs from `pipeline/`,
# in practice the crops accumulate NOT under the REPO ROOT but under `pipeline/storage/images`.
# Write an ABSOLUTE path here (a relative one is also accepted but it resolves
# relative to webapp's CWD -- a source of confusion):
#   CHATBOT_IMAGE_STORAGE_DIR=C:/Users/<user>/Desktop/medrag/pipeline/storage/images
# If left empty the endpoint returns 503 (meaning visual serving is not available in this
# deployment; the server STILL comes up). When set correctly the
# webapp logs "visual serving on: <dir> (N files)" at startup.
CHATBOT_IMAGE_STORAGE_DIR=

# ---------------------------------------------------------------------------
# [document download] — doc_id -> real file (ROADMAP 11a/11d)
# ---------------------------------------------------------------------------
# `GET /api/documents/<doc_id>` does NOT INVENT a new env -- `document.source_path`
# already stands as the full path in the database pointed to by CHATBOT_DB_QUERY_DB_PATH above
# (the committed facts/db/specs.db if empty)
# (see chatbot/chatbot/document_store.py + chatbot/chatbot/
# factory.py::resolve_db_path_from_env). You don't need to fill in anything.

# ---------------------------------------------------------------------------
# [evidence chunk corpus] — the chunk TEXT behind the [SQL] line (KARAR-069)
# ---------------------------------------------------------------------------
# The "Evidence (N)" panel below the answer also shows the text of the chunk a spec value
# was EXTRACTED from. `specs.db` does not store it -- it only keeps a pointer
# (`spec_value.source_chunk_id`/`evidence`, in `<doc_id>::cN` format); the text
# is in the chunker's output. This path points to that output.
#
# If left empty, it falls back to `chunker/storage/all_chunks.json` in the repo
# (the same env/bundled-fallback pattern as image_store/document_store; the `chunker`
# code is never imported, only the file is read). If the chunker was run with a custom
# root (CHUNKER_OUTPUT_DIR, KARAR-012) set this to point to that root too
# -- otherwise the panel says "chunk text not found in corpus".
# If the file does not exist at all, the feature is silently disabled, the server STILL comes up.
CHATBOT_CHUNK_CORPUS_PATH=

# ---------------------------------------------------------------------------
# [config override]
# ---------------------------------------------------------------------------
# Optional: a partial-override TOML file on top of config/default.toml.
# CHATBOT_CONFIG=

# ---------------------------------------------------------------------------
# [logging override] — optional operator shortcuts
# ---------------------------------------------------------------------------
# Persistent logging lives in config/default.toml [logging] (level/directory/rotation).
# webapp writes to chatbot/logs/chatbot.log at startup; every background stage +
# the SQL chain (linking/generation, sql_error+raw_text) falls to disk. The following
# envs OVERRIDE the config (quick override, no code/file change):
# CHATBOT_LOG_LEVEL=DEBUG          # see everything; WARNING -> query text hidden, errors remain
# CHATBOT_TEXT2SQL_LOG_LEVEL=DEBUG # only the detail level of the SQL chain
# CHATBOT_LOG_DIR=                 # move the log directory elsewhere (default chatbot/logs/)

# Per-conversation DETAILED log (see config/default.toml [conversation_log],
# chatbot/chatbot/conversation_log.py) -- a channel SEPARATE from [logging]: each
# conversation lives in its OWN folder (decision: 2026-08-06)
#     <dir>/<channel>/<conversation_id>/{meta.json, turns.jsonl, conversation.log}
# <channel> = web | whatsapp; <conversation_id> is the USER NUMBER on WhatsApp
# (each new number opens its own folder). turns.jsonl = one JSON line per turn
# (message + all intermediate steps + answer); conversation.log = the same turn's
# readable dump PLUS all the background log lines flowing during that turn
# (including SQL linking/generation). Enabled by default.
# WARNING: these files contain the user messages and WhatsApp phone numbers;
# chatbot/logs/ is gitignored, must not be committed.
# CHATBOT_CONVERSATION_LOG_ENABLED=false            # turn the record off completely
# CHATBOT_CONVERSATION_LOG_DIR=                      # move the directory elsewhere (default chatbot/logs/conversations/)
# CHATBOT_CONVERSATION_LOG_CAPTURE_BACKGROUND=false  # only keep message/answer+turns.jsonl, do not route background lines into the conversation folder

# ---------------------------------------------------------------------------
# [web interface] (chatbot.webapp)
# ---------------------------------------------------------------------------
# The address/port the web chat interface listens on. Defaults are in the code
# (127.0.0.1:8507). In med-rag the web interface is THE single presentation surface -- the
# WhatsApp bridge (wa_bot) and Redis queue from the original project were removed with this fork.
# CHATBOT_WEB_PORT=8507
# making host 0.0.0.0 EXPOSES the service to the NETWORK -- a deliberate choice; by
# default it is only reachable from localhost.
# CHATBOT_WEB_HOST=127.0.0.1

# ---------------------------------------------------------------------------
# [panel] — lineage_panel's deployable Flask entry point (M-07/M-14)
# ---------------------------------------------------------------------------
# `python -m medrag.api.panel.app` is this component's SEPARATE entry point --
# the SAME pattern as CHATBOT_WEB_HOST: making it 0.0.0.0 EXPOSES the panel to the NETWORK (I-31:
# the panel must not be reachable from the internet), default only localhost. The real
# "open to the internal network, closed to outside" guarantee is NOT this env, it's the
# deploy/firewall layer -- see the panel/app.py module docstring.
# PANEL_HOST=127.0.0.1
# A different port from webapp.
# PANEL_PORT=8010
# Write access (only updating the `resolved_*` fields, no trigger permission after K-60)
# is opened to requests carrying this SECRET in the header (`X-Panel-Write-Token`).
# If EMPTY/undefined the write endpoint is CLOSED TO EVERYONE
# (fail-closed) -- panel/auth.py::check_write_token.
PANEL_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# [Docker] — in-container addresses (Group H, S-11) -- NO VARIABLE ADDED,
# just an operator note
# ---------------------------------------------------------------------------
# In the compose stack QDRANT_URL is pinned to the service's own network in
# compose.yaml's `environment:` block (http://qdrant:6333) -- the value there
# OVERRIDES the one in this file; no need to write anything separate here for the container.
# To reach services running on the HOST (Ollama etc.) from the container use
# `host.docker.internal` NOT `127.0.0.1`/`localhost` (K-11;
# mapped on Linux via compose `extra_hosts`). specs.db does NOT enter the image
# (.dockerignore): in the container it must point to a volume path like
# CHATBOT_DB_QUERY_DB_PATH=/data/specs.db
# (S-15; which copy gets carried is the K-31 decision).

# ---------------------------------------------------------------------------
# [library] — document lifecycle (PLAN.md Group A)
# ---------------------------------------------------------------------------
# api writes/reads the SAME file contracts as pipeline-worker (no import):
#   BELGELER_DIR         corpus root (uploads; notes <root>/notlar/)
#   DOCUMENT_NODES_PATH  registry
#   PARSED_OUTPUT_DIR    parse output (for the markdown viewer)
#   ISLER_DIR            job queue (api WRITES, worker READS)
#   DURUM_DIR            status files (worker WRITES, api READS)
# Defaults (ISLER_DIR/DURUM_DIR) are siblings of the corpus root; BELGELER_DIR/
# DOCUMENT_NODES_PATH/PARSED_OUTPUT_DIR are REQUIRED -- if missing the relevant endpoint returns 503.
BELGELER_DIR=
DOCUMENT_NODES_PATH=
PARSED_OUTPUT_DIR=
# ISLER_DIR=
# DURUM_DIR=
# Max size per file (MB); default 200. Exceeding returns 400 + "exceeds the limit".
# MEDRAG_MAX_YUKLEME_MB=200

# ---------------------------------------------------------------------------
# [authentication] — single-user password (K3)
# ---------------------------------------------------------------------------
# If EMPTY/undefined auth is OFF (warned at startup). If defined, /api/*
# (except the auth endpoints) returns 401; the SPA shows the login screen.
MEDRAG_SIFRE=
# Session cookie signature. If undefined, derived from the password (single user is enough).
# MEDRAG_GIZLI_ANAHTAR=

# ---------------------------------------------------------------------------
# [SPA] — frontend build
# ---------------------------------------------------------------------------
# Default: <repo>/web/dist (the builder-web stage in the Dockerfile copies
# there). In development the `npm run build` output is also in the same place; it doesn't
# need to be overridden.
# MEDRAG_WEB_DIST=
