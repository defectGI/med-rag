# Copy this file to .env and fill in your values. .env is gitignored.
#
# WHAT LIVES WHERE (repo-wide taxonomy, see root CONFIG.md):
#   * This .env  = model CONNECTION identity + secrets + storage PATHS +
#                  deploy-specific bits. Machine/deploy-specific, never committed.
#   * config/default.toml = behavioral TUNING (thresholds, DPI, token budgets,
#                  concurrency, retries, feature toggles). Committed, reviewed.
#                  Every tuning knob can still be overridden per-run by setting
#                  its UPPER_CASE env var here (env wins over the TOML default) --
#                  that's how pipeline/config/*.env profiles work. The list of
#                  overridable tuning vars is at the bottom of this file.
#
# ---------------------------------------------------------------------------
# MODEL CONNECTION (secrets + provider/model identity)
# ---------------------------------------------------------------------------
#
# Local model (e.g. Ollama) via OpenAI-compatible endpoint:
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
# LLM_API_KEY=

# Anthropic:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-opus-4-8
# LLM_API_KEY=sk-ant-...

# Production default: local Ollama, on the GPU box. LLM = qwen2.5:32b, verified
# on the real corpus (no thinking mode, so it causes no trouble).
# Default (what the production .env uses): ollama
LLM_PROVIDER=
# Default (what the production .env uses): http://localhost:11434/v1
LLM_BASE_URL=
# Default (what the production .env uses): qwen2.5:32b
LLM_MODEL=
LLM_API_KEY=

# Thinking/reasoning toggle for hybrid-reasoning models (Qwen3/3.5, gpt-oss,
# ...). They can burn the whole token budget on hidden reasoning and return
# empty content on short-answer tasks, so it's disabled by default -- set to
# 1 to keep it on. Works for both "openrouter" and "ollama" providers (each
# uses its own field under the hood); a non-reasoning model just ignores the
# toggle either way. Available per prefix (LLM_/VLM_/VLM2_) and follows the
# same fallback rules as the other vars.
# Default (what the production .env uses): 0
LLM_THINKING_ON=

# Vision model for the pdf parser (hybrid/scanned pages). Every VLM_* variable
# falls back to its LLM_* counterpart, so if LLM_MODEL is already multimodal
# nothing extra is needed here.
# Production default: nemotron3:33b -- a model that IS capable of "thinking"
# (unlike qwen2.5vl); THINKING_ON=0 is requested from here, but whether it
# actually switches off is verified live by a smoke call in the preflight
# (../cli/ensure_ollama_models.py), which stops a run before it starts if a
# model silently ignores the toggle.
# Default (what the production .env uses): ollama
VLM_PROVIDER=
# Default (what the production .env uses): http://localhost:11434/v1
VLM_BASE_URL=
# Default (what the production .env uses): nemotron3:33b
VLM_MODEL=
VLM_API_KEY=
# Default (what the production .env uses): 0
VLM_THINKING_ON=   # falls back to LLM_THINKING_ON if unset, see above

# Ollama only: forces the context window (tokens) via Ollama's native
# /api/chat instead of /v1 -- the only way to raise num_ctx per request (the
# /v1 endpoint has none; an over-budget prompt is silently truncated, not
# rejected). benchmark/ applies its own safe default automatically when this
# is unset and the effective provider is ollama -- see benchmark/README.md.
# VLM_NUM_CTX=16384

# Optional independent role just for classify_crop's and
# classify_page_regions' "what type of visual region is this (and where)"
# calls (table vs chart vs block_diagram vs ..., per-crop or whole-page) --
# a cheap short-answer/grounding question that doesn't need the same model,
# or even the same server, as the page read / OCR / describe calls above.
# Each field falls
# back to its VLM_* counterpart, so setting only VLM_CLASSIFY_MODEL keeps the
# same provider/server and just swaps the model id. Setting
# VLM_CLASSIFY_PROVIDER/BASE_URL/API_KEY too points classify at a completely
# different server -- e.g. the example below runs classify locally on Ollama
# while VLM_PROVIDER above (describe/page-read/OCR) stays on a cloud
# provider. Unset entirely -> reuses the primary VLM client, no behavior
# change.
# Production default: a separate, cheap classifier instead of the main VLM
# (nemotron3:33b) -- qwen2.5vl:7b, no thinking, sufficient for a short-answer
# task.
# Default (what the production .env uses): ollama
VLM_CLASSIFY_PROVIDER=
# Default (what the production .env uses): http://localhost:11434/v1
VLM_CLASSIFY_BASE_URL=
# Default (what the production .env uses): qwen2.5vl:7b
VLM_CLASSIFY_MODEL=
VLM_CLASSIFY_API_KEY=
# Default (what the production .env uses): 0
VLM_CLASSIFY_THINKING_ON=

# Independent second vision model for consensus verification of suspicious
# regions. No fallback on purpose — leave unset to skip crop-and-reread
# (unconfirmed content is then labeled "unverified" with an audit crop).
# VLM2_PROVIDER=anthropic
# VLM2_BASE_URL=http://localhost:11434/v1
# VLM2_MODEL=claude-haiku-4-5-20251001
# VLM2_API_KEY=
# VLM2_THINKING_ON=1  # no fallback (independent verifier), same as VLM2_MODEL etc.

# Table-structure referee CONNECTION (tables/structure/). Unset/empty -> no
# referee is ever consulted; every PDF table is built by the deterministic path
# alone (parsers/table_bands.py, reads the page's own vector geometry -- no
# model, no network). The referee only ever supplies the grid SHAPE; each
# cell's text is always placed from the PDF's own characters, never the model's
# reading. (Its numeric knobs -- confidence/coverage thresholds, token budget --
# now live in config/default.toml under [pdf.table] and [table_struct].)
#   provider "tableformer" : local TableFormer model (no other TABLE_STRUCT_* needed)
#   provider "http"        : external structure-recognition service
#   provider "vlm"         : reuse the configured VLM_*/LLM_* vision model
# TABLE_STRUCT_PROVIDER=vlm
# TABLE_STRUCT_MODEL=        # vlm: overrides just the model id (same server as VLM_*)
# TABLE_STRUCT_BASE_URL=     # required for provider="http"
# TABLE_STRUCT_API_KEY=      # optional, provider="http" only

# ---------------------------------------------------------------------------
# DEPLOY-SPECIFIC
# ---------------------------------------------------------------------------

# Language(s) for the pdf parser's default Tesseract-based page detector,
# e.g. "tur+eng". Leave unset for Tesseract's own default.
# PDF_TESSERACT_LANG=tur+eng

# PROGRESS_IPC=1 is NOT set by hand: a parent runner that pipes this process's
# output (../cli/run_e2e_test.py / run_extra_corpus.py) sets it so progress.py
# emits @@BAR event lines the parent renders as live bars on its own terminal.
# (The on/off default for the bars themselves is config/default.toml [progress].)

# ---------------------------------------------------------------------------
# STORAGE PATHS (see storage_paths.py)
# ---------------------------------------------------------------------------
# All default to the dev-time storage/ layout below; set these to move raw
# input, parsed IR output, and the image/crop blob store somewhere else.
# STORAGE_RAW_DIR=storage/raw
# STORAGE_OUTPUT_DIR=storage/output
# STORAGE_IMAGES_DIR=storage/images
# STORAGE_LABELS_DIR=storage/labels

# PDF audit-crop store override, independent of STORAGE_IMAGES_DIR above
# (falls back to it when unset).
# PDF_CROP_DIR=

# ---------------------------------------------------------------------------
# TUNING OVERRIDES (defaults + docs in config/default.toml; set here to override)
# ---------------------------------------------------------------------------
# Each maps to a config/default.toml key; env value wins over the TOML default.
# See config/default.toml (commented) and root CONFIG.md for meanings.
#   [image_ocr]   IMAGE_OCR_CONFIDENCE_THRESHOLD  IMAGE_OCR_MAX_TOKENS
#                 IMAGE_CONCURRENCY  IMAGE_OCR_FALLBACK
#   [pdf]         PDF_RENDER_DPI  PDF_VLM  PDF_VLM_MAX_TOKENS  PDF_HEADING_RECONCILE
#                 PDF_FULLPAGE_RENDER_MIN_VECTOR  PDF_BROKEN_CMAP_MIN
#                 PDF_SCANNED_COVERAGE_MIN  PDF_LINE_MATCH  PDF_CONTAINMENT
#                 PDF_TESSERACT_FALLBACK
#   [pdf.table]   PDF_TABLE_BANDS_MIN_CONFIDENCE  PDF_TABLE_STRUCT_MIN_COVERAGE
#   [table]       TABLE_MAX_ROWS  TABLE_LLM_CHECK  TABLE_FACTS
#                 TABLE_HEADER_LLM  TABLE_CHECK_RETRIES
#                 (table-only strategy knobs: fidelity check, digit-checked facts)
#   [describe]    shared by every "describable block" (table, chart, block_diagram,
#                 technical_drawing, flowchart -- see parsers/base.py DescribableBlock):
#                 DESCRIBE_CONCURRENCY  DESCRIBE_MAX_TOKENS  DESCRIBE_CONTEXT
#                 DESCRIBE_CONTEXT_BEFORE  DESCRIBE_CONTEXT_AFTER
#                 DESCRIBE_CONTEXT_MAX_CHARS
#                 (the old TABLE_CONTEXT*/TABLE_CONCURRENCY names were retired,
#                 not aliased -- one setting must not be governed by two names.)
#   [table_struct] TABLE_STRUCT_MAX_TOKENS
#   [progress]    PROGRESS_BAR
#   [visual]      VISUAL_CLASSIFY  VISUAL_EXTRACT_CHARTS  VISUAL_EXTRACT_SMARTART
#                 VISUAL_MAX_TOKENS
#                 (exclude_types/types are lists -- override via PARSER_CONFIG
#                 partial TOML or default.toml directly, no env var for these;
#                 [describe].types -- which of those types actually get a
#                 description -- is likewise a list, same rule)

# =============================================================================
# VISUAL PROCESSING COST SWITCHES (on/off)
#
# All four produce VLM (vision model) calls and are the most expensive part of
# the nightly run. All are ON BY DEFAULT; writing `0` turns them off. Each can
# be flipped individually from the Coolify env screen -- no file editing needed.
#
# What to know before turning one off:
#
#   VISUAL_CLASSIFY       Labels every visual with a type (table/chart/photo...).
#                         The cheapest one (small model, single call). If turned
#                         off, the `[visual] exclude_types` filter stops working
#                         too.
#
#   IMAGE_OCR_ENABLED     Reading the text inside images. This text does not
#                         enter the chunk BODY anyway (chunker:
#                         `[images] inject_ocr = false`); it was only carried on
#                         the structured channel -- so turning it off costs
#                         retrieval nothing.
#
#   DESCRIBE_ENABLED      Natural-language descriptions of visuals. Image
#                         descriptions do not enter the chunk body either
#                         (`[visual] inject_image_description = false`).
#                         WARNING: this switch also turns off TABLE descriptions,
#                         and those DO enter the body -- that is the one real
#                         retrieval loss.
#
#   DESCRIBE_VISUAL_CHECK Verifies every generated description with a SECOND
#                         vision call and rewrites it, up to 3 attempts, if
#                         rejected. That multiplies description cost by 2-4x.
#                         This is where turning off gives the best payoff/risk
#                         ratio. (`DESCRIBE_ENABLED=0` means it never runs
#                         anyway.)
#
# With all four off, parsing makes no VLM call at all -- except scanned PDF
# pages, which are a separate switch: PDF_VLM. DO NOT TURN THAT ONE OFF; it is
# the only way to read the text of scanned documents, and if it is off those
# documents parse empty and the chatbot loses them completely.
# =============================================================================
VISUAL_CLASSIFY=
IMAGE_OCR_ENABLED=
DESCRIBE_ENABLED=
DESCRIBE_VISUAL_CHECK=
