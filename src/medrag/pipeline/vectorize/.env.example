# Copy: cp .env.example .env — .env is gitignored; secrets go there.

# --- Embedding provider -------------------------------------------------------
# ollama | openai | openrouter | local (one OpenAI-compatible client — same
# pattern as chunker's EMBEDDING_*/LLM_* decision; "anthropic" is unsupported).
# BASE_URL is optional for ollama/openai/openrouter (their natural roots are
# known) and REQUIRED for "local".
# EMBEDDING_MODEL, the Qdrant collection name in config/default.toml and the
# chatbot's .env MUST stay aligned — Qdrant does not verify the name against
# the model that wrote the vectors. On a model change, rename + recreate the
# collection (curl -X DELETE <qdrant>/collections/<name>) and update all
# three places, or every query fails with a dimension mismatch.
# Sizes: qwen3-embedding:0.6b -> 1024, qwen3-embedding:8b -> 4096.
# Note: chunker's RAPTOR clustering uses 0.6b separately; setting 8b here
# loads a SECOND embedding model on the GPU (extra VRAM).
# Default (used in the real .env): ollama
EMBEDDING_PROVIDER=
# Default (used in the real .env): qwen3-embedding:8b
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# --- Qdrant ---------------------------------------------------------------------
# Connection identity (root CONFIG.md: secrets/connection in .env, tuning such
# as the collection name in config/default.toml [qdrant]). If no Qdrant server
# is set up yet, this value is just a placeholder — the run exits with 2
# (config error) while QDRANT_URL is empty, so it cannot accidentally look
# "successful" before the server is ready.
# Default (used in the real .env): http://localhost:6333
QDRANT_URL=
QDRANT_API_KEY=

# --- Input/output ----------------------------------------------------------
# chunker's output — either a FOLDER (scanned recursively; every *.json inside
# is tried by content: both the legacy per-document `{doc_id}.chunks.json` and
# the new all_chunks.json/all_raptor.json/all_combined.json layouts) OR the
# path of a SINGLE JSON file (e.g. setups where the whole corpus is collected
# in one all_chunks.json). Name patterns are not trusted — same principle as
# chunker's own input discovery. Paths are relative to vectorize's own
# directory (same convention as PARSER_DIR in chunker/pipeline) — do not write
# absolute paths.
# Default (used in the real .env): ../chunker/storage
VECTORIZE_INPUT_DIR=
# Local output ROOT (gitignored) — keeps only state.json (staleness
# signatures) + run_log.json; the real output is the Qdrant collection (see
# storage/README.md).
# Default (used in the real .env): ./storage
VECTORIZE_OUTPUT_DIR=
# Optional: partial override TOML on top of config/default.toml.
VECTORIZE_CONFIG=
# Terminal progress bar: on (default) | off (same behavior as chunker/progress:
# renders if tqdm is installed and stderr is a real terminal).
# Default (used in the real .env): on
VECTORIZE_PROGRESS=
