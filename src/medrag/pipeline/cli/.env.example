# Copy this file to .env and fill in your values. .env is gitignored.
#
# Paths are relative to the src/medrag/pipeline/cli/ folder this .env lives in
# -- so it keeps working even if the repo is moved elsewhere (as long as the
# same internal hierarchy is preserved). You can also give an absolute path
# if you prefer; it's used as-is.

# root of the parser package (a sibling under src/medrag/pipeline/)
# Default (used in the real .env): ../parser
PARSER_DIR=

# root that document_nodes.json's rel_path values are relative to (the BELGELER folder)
# Default (used in the real .env): ../../../../chatbot-corpus/BELGELER
BELGELER_DIR=

# full path to document_info/document_nodes.json -- this file is updated in
# place by BOTH pipeline scripts: run_parse_pipeline.py writes each record's
# `parse` block, run_chunk_pipeline.py its `chunk` block. Unset/missing =
# the chunk script simply skips the registry step (ad-hoc run over a loose
# IR folder still works).
# Default (used in the real .env): ../../../../chatbot-corpus/document_info/document_nodes.json
DOCUMENT_NODES_PATH=

# folder the generated IR JSON files are written to.
# NOTE: run_full_corpus.py (the full end-to-end run) OVERRIDES this per run,
# redirecting it (plus STORAGE_IMAGES_DIR/PDF_CROP_DIR and CHUNKS_OUTPUT_DIR)
# into a single timestamped runs/<ts>/ directory so output doesn't accumulate
# -- see README. The value here is the default for the single-script runs
# (run_parse_pipeline.py on its own).
# Default (used in the real .env): ../../../../chatbot-corpus/document_info/parsed
PARSED_OUTPUT_DIR=

# Optional: only parse these doc_types (run_parse_pipeline.py only), comma-
# separated. Unset/empty = every type. Known values
# (chatbot-corpus/document_info/document_node_schema.md): BROCHURE,
# CATALOGUE, DATASHEET, CE_DECLARATION, TECHNICAL_DRAWING, USER_MANUAL,
# QUICK_START_GUIDE, STP, PRODUCT_IMAGE (the last two have no parser --
# selecting them just yields SKIPPED records, not an error).
# DOC_TYPES=DATASHEET,BROCHURE

# Note: LLM/VLM model settings (LLM_PROVIDER, LLM_BASE_URL, ...) don't live
# here, they stay inside PARSER_DIR/.env -- this script loads them automatically.

# Config PROFILE for run_e2e_test.py / run_extra_corpus.py: selects which
# config/<name>.env to apply. Unset = cfg_e2e_local (the default). Same as
# passing --profile <name>. (These profiles are model/table SETTINGS bundles,
# not paths -- see config/README.md.)
# PIPELINE_PROFILE=cfg3_consensus

# pipeline's own behavior tuning (DOC_CONCURRENCY, HEALTH_CHECK,
# HEALTH_FAIL_STREAK) now has its defaults + docs in pipeline_config.toml
# (committed). Each can still be overridden per-run by setting its UPPER_CASE
# env var here (env wins over the TOML default) -- see root CONFIG.md.
# DOC_CONCURRENCY=4
# HEALTH_CHECK=1
# HEALTH_FAIL_STREAK=3

# --- chunker integration (run_chunk_pipeline.py / run_chunk_test.py) --------
# CHUNKER_DIR is now only chunker's DATA home (its storage/ output default) --
# same relative-to-cli/ rule as above (chunker/ is 4 levels up from cli/).
# Default (used in the real .env): ../../../../chunker
CHUNKER_DIR=

# run_chunk_pipeline.py input: defaults to PARSED_OUTPUT_DIR above, so parse
# and chunk chain naturally. Override only to chunk some other IR folder.
# CHUNKER_INPUT_DIR=

# run_chunk_pipeline.py output ROOT. chunker lays out two files + viz/ under
# it (see chunker/storage/README.md):
#   all_chunks.json    doc_id -> ChunkSet -- registry's chunk.chunks_path
#                       points here
#   all_combined.json  same dict, wrapped
#   viz/                {doc_id}.tree.html + index.html
# Unset = CHUNKER_DIR/storage, i.e. chunker keeps its output at home.
# CHUNKS_OUTPUT_DIR=../../../../chunker/storage

# run_chunk_test.py input: any folder with parser IR JSONs. Unset = the
# newest run under src/medrag/pipeline/cli/e2e_test_output/ is used.
# CHUNK_TEST_INPUT_DIR=

# --- nightly report email (run_nightly.py, at end of full chain) -----------
# Empty/unset = email is NEVER sent (default off).
# NIGHTLY_REPORT_EMAIL_TO=someone@example.com,other@example.com
# Default: nightly@<hostname>
# NIGHTLY_REPORT_EMAIL_FROM=
# Local postfix relay -- default 127.0.0.1:25
# SMTP_HOST=127.0.0.1
# SMTP_PORT=25
# Body is ALWAYS a short numeric summary (result/added/removed/etc.) -- the
# full report is never embedded in the body, it always goes as a .md attachment.