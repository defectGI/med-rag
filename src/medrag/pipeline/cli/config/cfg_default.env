# General-purpose default profile -- table description enrichment fully on:
# context (heading + previous/next paragraph) is supplied, LLM check + retry
# loop runs. Datasheet tables usually appear right after a heading paragraph,
# so DESCRIBE_CONTEXT is especially meaningful here.
#
# This file used to be one of seven comparison profiles
# (cfg1_baseline..cfg7_full, a one-off quality-comparison test); the best
# combination was promoted to be the single default here. run_e2e_test.py
# still uses its own separate cfg_e2e_local.env (the local Ollama models
# actually installed on this machine); this file is the default for
# run_extra_corpus.py and general/ad-hoc runs.

LLM_PROVIDER=openrouter
LLM_MODEL=qwen/qwen3-vl-8b-instruct

VLM_PROVIDER=openrouter
VLM_MODEL=qwen/qwen3-vl-8b-instruct

TABLE_LLM_CHECK=1
DESCRIBE_CONTEXT=1
DESCRIBE_CONTEXT_BEFORE=2
DESCRIBE_CONTEXT_AFTER=1
DESCRIBE_CONTEXT_MAX_CHARS=600
TABLE_CHECK_RETRIES=3

STORAGE_OUTPUT_DIR=storage/output/cfg_default