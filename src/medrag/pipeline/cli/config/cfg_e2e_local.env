# cfg_e2e_local -- fully local Ollama run, used by run_e2e_test.py.
#
# All-Qwen2.5 set, chosen specifically because NEITHER model has a thinking/
# reasoning mode -- so there is no hidden reasoning to accidentally leave on.
# qwen2.5* sidestep that failure entirely (qwen3-vl's thinking cannot be
# reliably suppressed on Ollama and would otherwise empty OCR/table output).
#   LLM : qwen2.5:32b   -- text (table description, OCR check)
#   VLM : qwen2.5vl:7b  -- vision (OCR, hybrid/scanned pages, table grid).
#                          (qwen2.5vl only ships 3b/7b/32b/72b on ollama.com;
#                          7b is the closest tag to the "8b" originally asked
#                          for.)
# THINKING_ON=0 kept for belt-and-braces (these models ignore it). VLM2
# intentionally unset -- single-model run, no consensus verification
# (run_e2e_test.py force-blanks VLM2_* too so a stray parser/.env value can
# never leak in, see build_env()).

LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:32b
LLM_THINKING_ON=0

VLM_PROVIDER=ollama
VLM_MODEL=qwen2.5vl:7b
VLM_THINKING_ON=0

TABLE_STRUCT_PROVIDER=vlm
TABLE_LLM_CHECK=1
DESCRIBE_CONTEXT=1
DESCRIBE_CONTEXT_BEFORE=2
DESCRIBE_CONTEXT_AFTER=1
DESCRIBE_CONTEXT_MAX_CHARS=11000
TABLE_CHECK_RETRIES=3