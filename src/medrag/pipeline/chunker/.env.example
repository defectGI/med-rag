# Copy: cp .env.example .env — .env is gitignored, secrets go there.
# Core chunking needs no LLM/embedding settings.

# --- Tokenizer ---------------------------------------------------------------
# Chunk size is measured in tokens. Values:
#   - a tiktoken encoding name (e.g. cl100k_base, o200k_base)
#   - "fake": deterministic test counter (1 word = 1 token; not for production)
# Left empty/undefined, cl100k_base is used (see chunker/tokenization/factory.py).
# Default (in the real .env): cl100k_base
TOKENIZER=

# --- CLI (python -m medrag.pipeline.chunker) --------------------------------
# Configured via environment variables. The only flag exception is
# `--limit N`: process at most N IRs (first N in discovery order; for
# trial/sampling — not a persistent setting, hence a flag rather than env).
# Example: python -m medrag.pipeline.chunker --limit 5
# Input: folder where the parser's IR JSON outputs live; scanned
# recursively, a *.json is treated as IR only when its top level has
# ir_version + blocks (stage1/summary side files are skipped with a log
# entry).
# The two values below are deliberately LEFT EMPTY — the package is
# installed (`pip install -e .`), so the caller's cwd is no longer
# guaranteed to be chunker/'s own directory; a relative path assumption
# is not reliable. Real runs set them via the pipeline runners; when
# running by hand, supply absolute paths.
CHUNKER_INPUT_DIR=
# Output ROOT: all_chunks.json + all_combined.json + viz/ (HTML). Layout
# is defined in exactly one place: layout.py — see chunker/storage/README.md
# (the data still lives under repo-root chunker/storage/) and root CONFIG.md.
CHUNKER_OUTPUT_DIR=
# Optional: a partial override TOML applied on top of config/default.toml.
CHUNKER_CONFIG=
# Visualization: on (default) | off. When on, for each document a single
# offline interactive HTML tree ({doc_id}.tree.html) is produced, plus an
# index.html linking them; the path is logged at the end. Open in a
# browser to click through nodes and see text + metadata. Does not affect
# chunk output.
# Default (in the real .env): on
CHUNKER_VIZ=
# Terminal progress bar: on (default) | off. A tqdm bar over the document
# loop — rendered only if installed AND stderr is a real terminal,
# otherwise silently no-op (redirected log, CI, no tqdm). With the bar
# on, plain `log.info`/`log.exception` lines are written above the bar
# without breaking it.
# Default (in the real .env): on
CHUNKER_PROGRESS=