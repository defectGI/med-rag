# Paths are relative to the document_info/ folder where this .env lives --
# the script keeps working if the repo is moved (as long as the same
# internal hierarchy is preserved). An absolute path can also be given;
# it is used as-is.

# Root of the product_info folder - portable. The product_nodes.json
# path underneath is assumed fixed and not repeated here.
# Default (used in the real .env): ../product_info
PRODUCT_INFO_DIR=

# Full path of the BELGELER folder holding customer-facing product files.
# Default (used in the real .env): ../BELGELER
BELGELER_DIR=

# Full path of the document_nodes.json file to produce.
# Default (used in the real .env): document_nodes.json
OUTPUT_PATH=

# (Optional) Path of a partial TOML that overrides the scanning/classification
# tuning. Leave empty to use only config/default.toml. For tuning knobs
# (exclude lists, doc_type keywords, code pattern, extensions) see config/
# default.toml and the root CONFIG.md. Secrets/tuning are NOT written here
# (.env); only paths.
# DOCUMENT_INFO_CONFIG=config/local.toml
